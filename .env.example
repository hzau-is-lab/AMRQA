# Required for an OpenAI-compatible endpoint.
AMRQA_API_KEY=

# Optional. Leave unset for the OpenAI API; set this for a local/vLLM/Qwen endpoint.
AMRQA_BASE_URL=

# Optional explicit AMRlib checkpoint directories. Leave blank only when AMRlib's default
# model_stog and model_gtos folders have already been configured.
AMRQA_STOG_MODEL_DIR=
AMRQA_GTOS_MODEL_DIR=

# Optional local retrieval model directories; useful on air-gapped machines.
AMRQA_EMBEDDING_MODEL_DIR=
AMRQA_RERANKER_MODEL_DIR=
